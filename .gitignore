```gitignore
# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Miscellaneous
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env*
!.env.example
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local IDE settings
.vscode/*
!.vscode/extensions.json
.idea

# OS files
Thumbs.db
Desktop.ini
```